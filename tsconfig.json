{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "drizzle",
    "drizzle.config.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    ".cloudflare/types"
  ],
  "exclude": ["node_modules", "dist"]
}
