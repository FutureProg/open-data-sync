# Copy to .env (never commit .env). Void supports only `.env` locally, so this file is named example.env.

# PostgreSQL connection string (DigitalOcean). Used locally, by `pnpm db:migrate`,
# and set as a Worker secret for production.
DATABASE_URL=

# CA certificate (PEM) of the database, used to verify TLS. Quote it; newlines as \n.
DB_CA_CERT=

# Cloudflare deploy credentials (CI / non-interactive deploys).
# Token needs Workers Scripts: Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
