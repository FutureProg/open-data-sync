# Copy to .env (never commit .env).

# PostgreSQL connection string (DigitalOcean) and its CA certificate (PEM, quoted,
# newlines as \n). Used only by drizzle-kit (`pnpm db:migrate`); never deployed.
DATABASE_URL=
DB_CA_CERT=

# Where `cf dev` connects for the HYPERDRIVE binding. Use a LOCAL Postgres: workers
# cannot verify the DigitalOcean private CA, so the production DB won't work here.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Hyperdrive config ID for the Worker's database (read by cloudflare.config.ts at deploy time).
HYPERDRIVE_ID=

# Cloudflare deploy credentials (CI / non-interactive deploys).
# Token needs Workers Scripts: Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
